#!/bin/sh
# tmux가 항상 최신 forwarded agent를 쓰도록 고정 경로 링크 갱신
# 터미널이 붙은 대화형 접속(SSH_TTY)만 갱신한다. 명령 실행·파일 전송처럼 곧 끊기는 접속이
# 링크를 자기 소켓으로 바꾸면, 끊긴 뒤 링크가 죽은 소켓을 가리켜 git push 등이 실패한다.
if [ -n "$SSH_TTY" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock
fi

# ~/.ssh/rc가 있으면 sshd가 xauth를 대신 처리하지 않으므로 직접 처리 (sshd(8) 예시)
if read proto cookie && [ -n "$DISPLAY" ]; then
    if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
        echo add unix:$(echo "$DISPLAY" | cut -c11-) "$proto" "$cookie"
    else
        echo add "$DISPLAY" "$proto" "$cookie"
    fi | xauth -q -
fi
