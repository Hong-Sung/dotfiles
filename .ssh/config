
IgnoreUnknown UseKeychain

Include ~/.ssh/config.local

# agent 전달은 직접 관리하는 서버(mdk1=102, mdk2=103)에만. 기체 컴퓨터(rpi·jetson·orin)나
# 다른 호스트로는 보내지 않는다 — 그 호스트의 root가 접속 동안 내 키를 쓸 수 있다.
# ssh는 처음 정한 값을 쓰므로 이 블록이 아래 Host * 보다 앞에 있어야 한다.
Match host 10.29.16.102,10.29.16.103
    ForwardAgent yes
Match originalhost mdk1,mdk2,mdkorea,mdkorea-mdkorea
    ForwardAgent yes

Host *
    SetEnv TERM=xterm-256color
    ForwardAgent no
    AddKeysToAgent yes
    # 잠자기·네트워크 변경으로 끊긴 연결을 약 2분 안에 알아채고 끊는다. 끊긴 줄 모르고 남은 세션의
    # forwarded agent는 응답 없이 멈춰, 서버에서 ssh·git이 멈췄다(2026-10-09). 서버는 ClientAlive로 정리한다.
    ServerAliveInterval 30
    ServerAliveCountMax 4

Match exec "sh -c 'test $(uname) = Darwin'"
    UseKeychain yes
    AddKeysToAgent yes


Host github.com
    HostName github.com
    User git
