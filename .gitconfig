[core]
	excludesfile = ~/.gitignore
	editor = vim
[user]
	name = Kim Hong Sung
	email = unguest89@gmail.com
[init]
	defaultBranch = main
[pull]
	rebase = true
[alias]
	lg = log --oneline --graph --decorate --all
	st = status
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
